#!/system/bin/sh
# indroid neo: no netfilter in the in-process kernel. iptables/ip6tables
# (and their -restore/-save personalities, which are symlinks to this file)
# accept everything; the -restore daemon mode answers netd's "#PING" probes.
case "${0##*/}" in
  *-restore)
    while IFS= read -r line; do
      case "$line" in
        "#PING"*) echo "$line" ;;
      esac
    done
    ;;
esac
exit 0
